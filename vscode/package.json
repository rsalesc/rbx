{
  "name": "rbx-vscode",
  "displayName": "rbx",
  "description": "Browse rbx testcases and solution verdicts without leaving the editor.",
  "version": "0.1.0",
  "publisher": "rsalesc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsalesc/rbx.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/problem.rbx.yml",
    "onView:rbx.run"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rbx",
          "title": "rbx",
          "icon": "resources/rbx.svg"
        }
      ]
    },
    "views": {
      "rbx": [
        {
          "id": "rbx.run",
          "type": "webview",
          "name": "Run",
          "contextualTitle": "rbx"
        }
      ]
    },
    "commands": [
      {
        "command": "rbx.refresh",
        "title": "Refresh",
        "category": "rbx",
        "icon": "$(refresh)"
      },
      {
        "command": "rbx.openInput",
        "title": "Open Input",
        "category": "rbx",
        "icon": "$(file)"
      },
      {
        "command": "rbx.openOutput",
        "title": "Open Output",
        "category": "rbx"
      },
      {
        "command": "rbx.openAnswer",
        "title": "Open Expected Answer",
        "category": "rbx"
      },
      {
        "command": "rbx.openStderr",
        "title": "Open Stderr",
        "category": "rbx"
      },
      {
        "command": "rbx.diffOutput",
        "title": "Diff Output against Expected Answer",
        "category": "rbx",
        "icon": "$(git-compare)"
      },
      {
        "command": "rbx.revealInExplorer",
        "title": "Reveal Package in Explorer",
        "category": "rbx"
      },
      {
        "command": "rbx.copyPath",
        "title": "Copy Path",
        "category": "rbx"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rbx.refresh",
          "when": "view == rbx.run",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "rbx.openInput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@1"
        },
        {
          "command": "rbx.openOutput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@2"
        },
        {
          "command": "rbx.openAnswer",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@3"
        },
        {
          "command": "rbx.openStderr",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@4"
        },
        {
          "command": "rbx.diffOutput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "2_compare@1"
        },
        {
          "command": "rbx.copyPath",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "3_copy@1"
        },
        {
          "command": "rbx.revealInExplorer",
          "when": "webviewSection == 'rbx.package'",
          "group": "3_copy@1"
        }
      ]
    },
    "colors": [
      {
        "id": "rbx.expectedAccepted",
        "description": "A solution declared to be accepted.",
        "defaults": { "dark": "charts.green", "light": "charts.green", "highContrast": "charts.green" }
      },
      {
        "id": "rbx.expectedIncorrect",
        "description": "A solution declared to answer wrongly, or to fail some other way.",
        "defaults": { "dark": "charts.red", "light": "charts.red", "highContrast": "charts.red" }
      },
      {
        "id": "rbx.expectedSlow",
        "description": "A solution declared to run out of time or memory.",
        "defaults": { "dark": "charts.yellow", "light": "charts.yellow", "highContrast": "charts.yellow" }
      },
      {
        "id": "rbx.expectedError",
        "description": "A solution declared to crash or to fail compilation.",
        "defaults": { "dark": "charts.blue", "light": "charts.blue", "highContrast": "charts.blue" }
      },
      {
        "id": "rbx.expectedOther",
        "description": "A solution declared to over-print or to break the checker.",
        "defaults": { "dark": "charts.purple", "light": "charts.purple", "highContrast": "charts.purple" }
      },
      {
        "id": "rbx.expectedAny",
        "description": "A solution that declares no outcome.",
        "defaults": { "dark": "foreground", "light": "foreground", "highContrast": "foreground" }
      },
      {
        "id": "rbx.declaredRole",
        "description": "A generator, validator, checker, interactor, visualizer or statement.",
        "defaults": { "dark": "descriptionForeground", "light": "descriptionForeground", "highContrast": "descriptionForeground" }
      }
    ],
    "configuration": {
      "title": "rbx",
      "properties": {
        "rbx.decorateExplorer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Badge the files `problem.rbx.yml` declares in the Explorer and on editor tabs: solutions with their expected outcome, everything else with its role."
        },
        "rbx.solutionCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what `problem.rbx.yml` declares a solution to do on a CodeLens above its first line."
        },
        "rbx.solutionStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what `problem.rbx.yml` declares a solution to do in the language status area, which stays visible while you scroll."
        },
        "rbx.packageSearchDepth": {
          "type": "number",
          "default": 3,
          "markdownDescription": "How deep to search workspace folders for `problem.rbx.yml` files."
        },
        "rbx.solutionLabel": {
          "type": "string",
          "enum": [
            "full",
            "trimmed",
            "basename"
          ],
          "default": "trimmed",
          "markdownDescription": "How the Run view names a solution. Filtering always matches the full path, whatever is shown.",
          "enumDescriptions": [
            "The full path, relative to the package root: `sols/main.cpp`.",
            "The path without the directory every solution in the package shares: `main.cpp`, and `slow/tle.cpp` for one nested deeper.",
            "The file name alone: `main.cpp`, and `tle.cpp` for `sols/slow/tle.cpp`."
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "pretest": "node esbuild.test.mjs",
    "test": "node --test \"out-test/**/*.test.js\"",
    "lint": "eslint src",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vscode/codicons": "^0.0.36",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
