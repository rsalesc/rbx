[5.792375, "o", "\ufffd\ufffd\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\u001b[0m\r\n\u001b[90m\u2502\u001b[0m\u001b[1;34m \u001b[0m\u001b[1;34m(base)   \u001b[0m\u001b[1;34m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m \u001b[0m\u001b[97m        2\u001b[0m\u001b[97m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97m    \u001b[0m\u001b[1;36m200\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;2;97mms\u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m \u001b[0m\u001b[1;32mestimated (fastest \u001b[0m\u001b[1;36m29\u001b[0m\u001b[1;32m \u001b[0m\u001b[1;2;32mms\u001b[0m\u001b[1;32m / slowest \u001b[0m\u001b[1;36m73\u001b[0m\u001b[1;32m \u001b[0m\u001b[1;2;32mms\u001b[0m\u001b[1;32m) [\u2265 \u001b[0m\u001b[1;36m146\u001b[0m\u001b[1;32m \u001b[0m\u001b[1;2;32mms\u001b[0m\u001b[1;32m from \u001b[0m\u001b[97m            \u001b[0m\u001b[97m \u001b[0m\u001b[90m\u2502\u001b[0m\r\n\u001b[90m\u2502\u001b[0m\u001b[1;34m           \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m           \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[1;97m            \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m \u001b[0m\u001b[1;32msols/main.py]\u001b[0m\u001b[97m                                                        \u001b[0m\u001b[97m \u001b[0m\u001b[90m\u2502\u001b[0m\r\n\u001b[90m\u2502\u001b[0m\u001b[1;34m \u001b[0m\u001b[1;34m* cpp, c \u001b[0m\u001b[1;34m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m \u001b[0m\u001b[97m        1\u001b[0m\u001b[97m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97m    \u001b[0m\u001b[1;36m100\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;2;97mms\u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2502\u001b[0m\u001b[97m \u001b[0m\u001b[1;32mestimate"]
