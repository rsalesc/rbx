[12.866118, "o", "\u001b[1;31m\u2717 \u001b[0m\u001b]8;;file://~/problems/timing-problem/sols/mislabeled.cpp\u001b\\\u001b[1;33msols/mislabeled.cpp\u001b[0m\u001b]8;;\u001b\\\u001b[1;31m runs in 33 ms, but the estimated limit of 100 ms requires every solution \u001b[0m\r\n\u001b[1;31mexpected to be too slow to take at least 150 ms (timeLimitToTle 1.5). Speed up the accepted \u001b[0m\r\n\u001b[1;31msolutions, slow this one down, or relax the ratios.\u001b[0m\r\n"]
