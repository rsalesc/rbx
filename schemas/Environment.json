{
    "$defs": {
        "AssetKind": {
            "enum": [
                "generator",
                "validator",
                "solution",
                "checker",
                "interactor",
                "visualizer"
            ],
            "title": "AssetKind",
            "type": "string"
        },
        "BocaExtension": {
            "properties": {
                "flags": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {},
                    "propertyNames": {
                        "enum": [
                            "c",
                            "cpp",
                            "cc",
                            "kt",
                            "java",
                            "py2",
                            "py3"
                        ]
                    },
                    "title": "Flags",
                    "type": "object"
                },
                "minRunningTime": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0,
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Minrunningtime"
                },
                "preferContestLetter": {
                    "default": false,
                    "title": "Prefercontestletter",
                    "type": "boolean"
                },
                "usePypy": {
                    "default": false,
                    "title": "Usepypy",
                    "type": "boolean"
                },
                "languages": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "deprecated": true,
                    "title": "Languages"
                },
                "maximumTimeError": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "deprecated": true,
                    "title": "Maximumtimeerror"
                }
            },
            "title": "BocaExtension",
            "type": "object"
        },
        "BocaLanguageExtension": {
            "properties": {
                "languages": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Languages"
                },
                "template": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Template"
                },
                "bocaLanguage": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "deprecated": true,
                    "title": "Bocalanguage"
                }
            },
            "title": "BocaLanguageExtension",
            "type": "object"
        },
        "CompilationConfig": {
            "properties": {
                "commands": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": [],
                    "description": "Commands to compile the program.",
                    "title": "Commands"
                },
                "sandbox": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EnvironmentSandbox"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Sandbox configuration to use when compiling for this language."
                },
                "passthrough": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Whether to pass through the compilable as an executable file.",
                    "title": "Passthrough"
                },
                "solutionOverrides": {
                    "$ref": "#/$defs/SolutionCompilationOverrides",
                    "description": "Overrides to apply when compiling solutions for this language."
                }
            },
            "title": "CompilationConfig",
            "type": "object"
        },
        "EnvironmentLanguage": {
            "properties": {
                "name": {
                    "description": "Identifier of this language within this environment.",
                    "title": "Name",
                    "type": "string"
                },
                "readableName": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Readable name for this language.",
                    "title": "Readablename"
                },
                "extension": {
                    "description": "File extension supported by this language. If there's only one language\nthat supports a certain file extension in the environment, the tool\nwill automatically identify the language based on such extension.",
                    "title": "Extension",
                    "type": "string"
                },
                "extraExtensions": {
                    "description": "Extra file extensions supported by this language. If not specified, the tool\nwill automatically identify the language based on such extensions.",
                    "items": {
                        "type": "string"
                    },
                    "title": "Extraextensions",
                    "type": "array"
                },
                "compilation": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CompilationConfig"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Compilation config to use when compiling programs for this language."
                },
                "execution": {
                    "$ref": "#/$defs/ExecutionConfig",
                    "description": "Execution config to use when running programs for this language."
                },
                "fileMapping": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FileMapping"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Mapping for files within the sandbox. If not specified, the default mapping\nfor the environment will be used."
                },
                "extensions": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/LanguageExtensions"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Extensions to apply for this language."
                },
                "linters": {
                    "description": "Linters to run for this language during compilation.",
                    "items": {
                        "$ref": "#/$defs/LinterConfig"
                    },
                    "title": "Linters",
                    "type": "array"
                },
                "scanners": {
                    "description": "Dependency scanners (by registry name) to apply for this\nlanguage, in addition to the ones automatically selected by language kind.",
                    "items": {
                        "type": "string"
                    },
                    "title": "Scanners",
                    "type": "array"
                },
                "timing": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/LanguageTimingConfig"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Per-language overrides for timing configuration (e.g. wall time)."
                }
            },
            "required": [
                "name",
                "extension",
                "execution"
            ],
            "title": "EnvironmentLanguage",
            "type": "object"
        },
        "EnvironmentSandbox": {
            "properties": {
                "maxProcesses": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": 1,
                    "description": "Max. number of process to allow to run concurrently for the program.",
                    "title": "Maxprocesses"
                },
                "timeLimit": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Time limit in milliseconds to allow the program to run.",
                    "title": "Timelimit"
                },
                "wallTimeLimit": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Wall time limit in milliseconds to allow the program to run.",
                    "title": "Walltimelimit"
                },
                "memoryLimit": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Memory limit in MiB.",
                    "title": "Memorylimit"
                },
                "fileSizeLimit": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "File size limit in KiB",
                    "title": "Filesizelimit"
                },
                "stackLimit": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Stack limit in MiB.",
                    "title": "Stacklimit"
                },
                "preserveEnv": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": false,
                    "description": "Whether to preserve env. variables coming from the host.",
                    "title": "Preserveenv"
                },
                "mirrorDirs": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": [],
                    "description": "Directories in the host that should be read-only exposed to the sandbox.",
                    "title": "Mirrordirs"
                }
            },
            "title": "EnvironmentSandbox",
            "type": "object"
        },
        "ExecutionConfig": {
            "properties": {
                "command": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Command to run the program.",
                    "title": "Command"
                },
                "sandbox": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EnvironmentSandbox"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Sandbox configuration to use when executing for this language."
                },
                "problemLimits": {
                    "$ref": "#/$defs/Limits",
                    "description": "Original limits of the problem."
                },
                "solutionOverrides": {
                    "$ref": "#/$defs/SolutionExecutionOverrides",
                    "description": "Overrides to apply when executing solutions for this language."
                }
            },
            "title": "ExecutionConfig",
            "type": "object"
        },
        "Extensions": {
            "properties": {
                "boca": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/BocaExtension"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Environment-level extensions for BOCA packaging."
                }
            },
            "title": "Extensions",
            "type": "object"
        },
        "FileMapping": {
            "properties": {
                "input": {
                    "default": "stdin",
                    "description": "Path where to copy the stdin file to before running the program,\nrelative to the sandbox root.",
                    "title": "Input",
                    "type": "string"
                },
                "output": {
                    "default": "stdout",
                    "description": "Path where to output the stdout file after running the program,\nrelative to the sandbox root.",
                    "title": "Output",
                    "type": "string"
                },
                "error": {
                    "default": "stderr",
                    "description": "Path where to output the stderr file after running the program,\nrelative to the sandbox root.",
                    "title": "Error",
                    "type": "string"
                },
                "capture": {
                    "default": "capture",
                    "description": "Path where to output the capture file after running the program,\nrelative to the sandbox root.",
                    "title": "Capture",
                    "type": "string"
                },
                "compilable": {
                    "default": "{source}",
                    "description": "Path where to copy the compilable file to before compiling the program,\nrelative to the sandbox root.",
                    "title": "Compilable",
                    "type": "string"
                },
                "executable": {
                    "default": "executable",
                    "description": "Path to where to output the executable file after compiling the program,\nrelative to the sandbox root.",
                    "title": "Executable",
                    "type": "string"
                }
            },
            "title": "FileMapping",
            "type": "object"
        },
        "LanguageExtensions": {
            "properties": {
                "boca": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/BocaLanguageExtension"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Language-level extensions for BOCA packaging."
                },
                "moj": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/MojLanguageExtension"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Language-level extensions for MOJ packaging."
                },
                "polygon": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PolygonLanguageExtension"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Language-level extensions for Polygon packaging."
                }
            },
            "title": "LanguageExtensions",
            "type": "object"
        },
        "LanguageGroup": {
            "properties": {
                "languages": {
                    "description": "rbx language names that share a single estimated time limit.",
                    "items": {
                        "type": "string"
                    },
                    "title": "Languages",
                    "type": "array"
                },
                "whenEmpty": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/LanguageGroupFallback"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "How to derive a TL for this group when it has no solutions."
                }
            },
            "required": [
                "languages"
            ],
            "title": "LanguageGroup",
            "type": "object"
        },
        "LanguageGroupFallback": {
            "properties": {
                "relativeTo": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A language name whose group's estimated TL this empty group is\nrelative to. If omitted, the multiplier is applied to the base estimate.",
                    "title": "Relativeto"
                },
                "multiplier": {
                    "description": "Slope applied to the reference TL when this group has no\nsolutions. The resolved TL is ``multiplier * reference + increment``.",
                    "exclusiveMinimum": 0,
                    "title": "Multiplier",
                    "type": "number"
                },
                "increment": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Constant offset (in milliseconds) added on top of the\nmultiplied reference TL when this group has no solutions. The resolved TL is\n``multiplier * reference + increment``.",
                    "title": "Increment"
                }
            },
            "required": [
                "multiplier"
            ],
            "title": "LanguageGroupFallback",
            "type": "object"
        },
        "LanguageTimingConfig": {
            "properties": {
                "wallTimeMultiplier": {
                    "anyOf": [
                        {
                            "minimum": 1.0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Overrides the environment wall-time multiplier `a` for this language.",
                    "title": "Walltimemultiplier"
                },
                "wallTimeIncrement": {
                    "anyOf": [
                        {
                            "minimum": 0,
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Overrides the environment wall-time increment `b` (in milliseconds) for this language.",
                    "title": "Walltimeincrement"
                }
            },
            "title": "LanguageTimingConfig",
            "type": "object"
        },
        "Limits": {
            "properties": {
                "time": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Value to override time limit with, in milliseconds.",
                    "title": "Time"
                },
                "configuredTime": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The declared time limit, in milliseconds, regardless of whether it is enforced for a given run. ``time`` is nulled to signal \"do not enforce a TL\", which loses the declared value; this preserves it for display/reporting.",
                    "title": "Configuredtime"
                },
                "memory": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Value to override memory limit with, in MB.",
                    "title": "Memory"
                },
                "output": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Value to override output limit with, in KB.",
                    "title": "Output"
                },
                "isDoubleTL": {
                    "default": false,
                    "description": "Whether to use double TL for this language.",
                    "title": "Isdoubletl",
                    "type": "boolean"
                },
                "profile": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The profile that was used to get these limits.",
                    "title": "Profile"
                }
            },
            "title": "Limits",
            "type": "object"
        },
        "LinterConfig": {
            "properties": {
                "name": {
                    "description": "Name of the linter to run (see registry).",
                    "title": "Name",
                    "type": "string"
                },
                "applies_to": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/AssetKind"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Asset kinds this linter applies to. None means all kinds.",
                    "title": "Applies To"
                }
            },
            "required": [
                "name"
            ],
            "title": "LinterConfig",
            "type": "object"
        },
        "MojLanguageExtension": {
            "description": "Language-level extensions for MOJ packaging.\n\nMirrors ``BocaLanguageExtension``: an rbx language declares which MOJ language ids\nit maps to, and which on-disk script template to emit for them.",
            "properties": {
                "languages": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "MOJ language ids this rbx language maps to. The first entry is the canonical one; every entry gets its own scripts/<id>/ directory in the package.",
                    "title": "Languages"
                },
                "template": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "On-disk template dir under rbx/resources/packagers/moj/scripts/ to source the per-language compile.sh and run.sh from. Required whenever `languages` is set.",
                    "title": "Template"
                },
                "flags": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Compilation flags substituted into the template. Leave unset to use the template's own default.",
                    "title": "Flags"
                }
            },
            "title": "MojLanguageExtension",
            "type": "object"
        },
        "PolygonLanguageExtension": {
            "properties": {
                "polygonLanguage": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Polygonlanguage"
                }
            },
            "title": "PolygonLanguageExtension",
            "type": "object"
        },
        "SolutionCompilationOverrides": {
            "properties": {
                "commands": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": [],
                    "description": "Commands to compile the program.",
                    "title": "Commands"
                },
                "sandbox": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EnvironmentSandbox"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Sandbox configuration to use when compiling for this language."
                },
                "passthrough": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Whether to pass through the compilable as an executable file.",
                    "title": "Passthrough"
                }
            },
            "title": "SolutionCompilationOverrides",
            "type": "object"
        },
        "SolutionExecutionOverrides": {
            "properties": {
                "command": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Command to run the program.",
                    "title": "Command"
                },
                "sandbox": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EnvironmentSandbox"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Sandbox configuration to use when executing for this language."
                },
                "problemLimits": {
                    "$ref": "#/$defs/Limits",
                    "description": "Original limits of the problem."
                }
            },
            "title": "SolutionExecutionOverrides",
            "type": "object"
        },
        "TimingConfig": {
            "properties": {
                "formula": {
                    "anyOf": [
                        {
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Formula to use to calculate the time limit for the environment.\nMutually exclusive with `multipliers`. When neither is set, a default formula is\nused.",
                    "title": "Formula"
                },
                "multipliers": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimingMultipliers"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Ratios used to infer the time limit from the measured\nsolutions. Mutually exclusive with `formula`."
                },
                "inferenceTimeout": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0,
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Time limit (in milliseconds) enforced on every solution run\nwhile the time limit is estimated, whatever the estimation strategy is. A solution\nexpected to be too slow that hits it is dropped from the upper bound; an accepted one\nthat hits it is an error. Defaults to 10s.",
                    "title": "Inferencetimeout"
                },
                "groups": {
                    "description": "Groups of related languages that share an estimated time limit.",
                    "items": {
                        "$ref": "#/$defs/LanguageGroup"
                    },
                    "title": "Groups",
                    "type": "array"
                },
                "wallTimeMultiplier": {
                    "default": 2.0,
                    "description": "Default multiplier `a` in the wall-time formula `a*x + b`, where `x` is the expanded CPU time limit.",
                    "minimum": 1.0,
                    "title": "Walltimemultiplier",
                    "type": "number"
                },
                "wallTimeIncrement": {
                    "default": 0,
                    "description": "Default increment `b` (in milliseconds) in the wall-time formula `a*x + b`.",
                    "minimum": 0,
                    "title": "Walltimeincrement",
                    "type": "integer"
                }
            },
            "title": "TimingConfig",
            "type": "object"
        },
        "TimingMultipliers": {
            "properties": {
                "acToTimeLimit": {
                    "description": "Minimum ratio between the time limit and the slowest accepted\nsolution, used to estimate the time limit from below: the slowest accepted solution\ntimes `acToTimeLimit` must fit within the time limit.",
                    "exclusiveMinimum": 0,
                    "title": "Actotimelimit",
                    "type": "number"
                },
                "timeLimitToTle": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Minimum ratio between the fastest solution expected to be too\nslow and the time limit: the time limit times `timeLimitToTle` must fit within the\nfastest solution expected to be too slow. When omitted, solutions expected to be too\nslow are not run and the time limit is not bounded from above.",
                    "title": "Timelimittotle"
                },
                "inferenceTimeout": {
                    "anyOf": [
                        {
                            "exclusiveMinimum": 0,
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Deprecated: use `timing.inferenceTimeout`, which applies to\nevery estimation strategy instead of only to multiplier-based ones. Kept for\nbackwards compatibility; setting both is an error.",
                    "title": "Inferencetimeout"
                },
                "timeResolution": {
                    "default": 100,
                    "description": "Granularity (in milliseconds) of the estimated time limit.\nThe estimate is the smallest multiple of this value that is valid.",
                    "exclusiveMinimum": 0,
                    "title": "Timeresolution",
                    "type": "integer"
                }
            },
            "required": [
                "acToTimeLimit"
            ],
            "title": "TimingMultipliers",
            "type": "object"
        }
    },
