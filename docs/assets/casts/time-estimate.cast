[6.20048, "o", "\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0;1mAssign each language to a time-limit bucket:\u001b[0m\r\r\n\r\r\n\u001b[0m  [N] grouped    shares one estimated limit with same-numbered langs\u001b[0m\r\r\n\u001b[0m  [X] singleton  its own estimated limit\u001b[0m\r\r\n\u001b[0m  [ ] leftover   pooled with all other unmarked langs (default)\u001b[0m\r\r\n\r\r\n\u001b[0;90m\u2191/\u2193 or k/j move \u00b7 1-9 group \u00b7 space/tab [X]/[ ] \u00b7 0 leftover \u00b7 r derive limit from a group \u00b7 R rese\r\u001b[99Ct\u001b[0m\r\r\n\u001b[0;1;7m\u276f \u001b[0;33;1m[ ] \u001b[0;1;7mcpp\u001b[0m\r\r\n\u001b[0m  \u001b[0;33m[ ] \u001b[0mc\u001b[0m\r\r\n\u001b[0m  \u001b[0;33m[1] \u001b[0mpy\u001b[0m\r\r\n\u001b[0m  \u001b[0;33m[2] \u001b[0mjava\u001b[0;32m  \u2192 cpp \u00d72\u001b[0m\r\r\n\u001b[0m  \u001b[0;33m[2] \u001b[0mkt\u001b[0;32m  \u2192 cpp \u00d72\u001b[0m\r\r\n\u001b[0;97;1m                                              Preview                                              \r\u001b[99C \u001b[0m\r\r\n\u001b[0;90m\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\ufffd"]
