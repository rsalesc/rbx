          "when": "webviewSection == 'rbx.testsetTestcase'",
          "group": "0_run@2"
        }
      ],
      "explorer/context": [
        {
          "command": "rbx.runSolution",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.solutionFiles",
          "group": "0_rbx@1"
        },
        {
          "command": "rbx.promoteInput",
          "when": "resourceScheme == file && resourceExtname == .in",
          "group": "0_rbx@2"
        }
      ],
      "editor/context": [
        {
          "command": "rbx.runSolution",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.solutionFiles",
          "group": "0_rbx@1"
        },
        {
          "command": "rbx.testplan.generate",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles",
          "group": "0_rbx@1"
        },
        {
          "command": "rbx.testplan.validate",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles",
          "group": "0_rbx@2"
        },
        {
          "command": "rbx.testplan.run",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.testplanFiles",
          "group": "0_rbx@3"
        },
        {
          "command": "rbx.testplan.promote",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles",
          "group": "0_rbx@4"
        },
        {
          "command": "rbx.irunInput",
          "when": "rbx.dispatchEnabled && editorTextFocus",
          "group": "0_rbx@5"
        },
        {
          "command": "rbx.promoteInput",
          "when": "editorTextFocus && !(resourcePath in rbx.testplanFiles)",
          "group": "0_rbx@5"
        },
        {
          "command": "rbx.irunGenerator",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.testplanFiles",
          "group": "0_rbx@6"
        }
      ],
      "view/item/context": [
        {
          "command": "rbx.assets.openSource",
          "when": "view == rbx.assets && viewItem == rbx.asset.statement",
          "group": "inline"
        },
        {
          "command": "rbx.assets.run",
          "when": "view == rbx.assets && viewItem == rbx.asset.solution && rbx.dispatchEnabled",
          "group": "inline"
        },
        {
          "command": "rbx.assets.chooseContest",
          "when": "view == rbx.assets && viewItem == rbx.assets.contest && rbx.assets.hasVariants",
          "group": "inline"
        },
        {
          "command": "rbx.assets.openToSide",
          "when": "view == rbx.assets && viewItem =~ /^rbx\\.asset\\./",
          "group": "navigation@1"
        },
        {
          "command": "rbx.assets.reveal",
          "when": "view == rbx.assets && viewItem =~ /^rbx\\.asset\\./",
          "group": "navigation@2"
        },
        {
          "command": "rbx.assets.copyPath",
          "when": "view == rbx.assets && viewItem =~ /^rbx\\.asset\\./",
          "group": "6_copypath@1"
        }
      ]
    },
    "colors": [
      {
        "id": "rbx.expectedAccepted",
        "description": "A solution declared to be accepted.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green"
        }
      },
      {
        "id": "rbx.expectedIncorrect",
        "description": "A solution declared to answer wrongly, or to fail some other way.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red"
        }
      },
      {
        "id": "rbx.expectedSlow",
        "description": "A solution declared to run out of time or memory.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow"
        }
      },
      {
        "id": "rbx.expectedError",
        "description": "A solution declared to crash or to fail compilation.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue"
        }
      },
      {
        "id": "rbx.expectedOther",
        "description": "A solution declared to over-print or to break the checker.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple"
        }
      },
      {
        "id": "rbx.expectedAny",
        "description": "A solution that declares no outcome.",
        "defaults": {
          "dark": "foreground",
          "light": "foreground",
          "highContrast": "foreground"
        }
      },
      {
        "id": "rbx.declaredRole",
        "description": "A generator, validator, checker, interactor, visualizer or statement.",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "descriptionForeground"
        }
      },
      {
        "id": "rbx.interaction.interactorForeground",
        "description": "The arrow before a line the interactor wrote, in the interaction transcript.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green"
        }
      },
      {
        "id": "rbx.interaction.solutionForeground",
        "description": "The arrow before a line the solution wrote, in the interaction transcript.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue"
        }
      },
      {
        "id": "rbx.interaction.stderrForeground",
        "description": "The marker before a line of the solution's stderr, in the interaction transcript.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red"
        }
      },
      {
        "id": "rbx.interaction.interactorBackground",
        "description": "The tint behind a line the interactor wrote, in the interaction transcript.",
        "defaults": {
          "dark": "#89d18514",
          "light": "#38803014",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "rbx.interaction.solutionBackground",
        "description": "The tint behind a line the solution wrote, in the interaction transcript.",
        "defaults": {
          "dark": "#75beff14",
          "light": "#1a85ff14",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "rbx.interaction.stderrBackground",
        "description": "The tint behind a line of the solution's stderr, in the interaction transcript.",
        "defaults": {
          "dark": "#f1484c1f",
          "light": "#e5141a1a",
          "highContrast": "#00000000"
        }
      }
    ],
    "configuration": {
      "title": "rbx",
      "properties": {
        "rbx.decorateExplorer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Badge the files `problem.rbx.yml` declares in the Explorer and on editor tabs: solutions with their expected outcome, everything else with its role."
        },
        "rbx.solutionCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what `problem.rbx.yml` declares a solution to do on a CodeLens above its first line."
        },
        "rbx.testplanCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show *Generate · Validate · Run · Promote* on a CodeLens above every test of a testplan (a `.txt` `generatorScript`)."
        },
        "rbx.solutionStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what `problem.rbx.yml` declares a solution to do in the language status area, which stays visible while you scroll."
        },
        "rbx.statementVarHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what each `\\VAR{...}` in a statement expands to, beside the reference."
        },
        "rbx.compilationDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report what the last `rbx run` compiled in the Problems panel: a warning on each line the compiler warned about, and an error on any solution that failed to compile."
        },
        "rbx.solutionLabel": {
          "type": "string",
          "enum": [
            "full",
            "trimmed",
            "basename"
          ],
          "default": "trimmed",
          "markdownDescription": "How the Run view names a solution. Filtering always matches the full path, whatever is shown.",
          "enumDescriptions": [
            "The full path, relative to the package root: `sols/main.cpp`.",
            "The path without the directory every solution in the package shares: `main.cpp`, and `slow/tle.cpp` for one nested deeper.",
            "The file name alone: `main.cpp`, and `tle.cpp` for `sols/slow/tle.cpp`."
          ]
        },
        "rbx.testcaseLayout": {
          "type": "string",
          "enum": [
            "below",
            "beside"
          ],
          "default": "below",
          "markdownDescription": "How the two testcase panes are arranged the **first** time they are opened. Only a seed: once the panes exist the extension reuses whichever editor groups they are in, so an arrangement you set yourself is kept.",
          "enumDescriptions": [
            "The input above, the output diff below -- the way `rbx ui` stacks them. The diff gets the full editor width, so it keeps its side-by-side view.",
            "The input in its own column, the output diff beside it. Roomier for a long testcase, but a narrow diff renders inline unless you also set `diffEditor.useInlineViewWhenSpaceIsLimited` to `false`."
          ]
        },
        "rbx.executable": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Full path to the `rbx` executable, used when visualizing a testcase, when reading a problem's vars for statement hints, and as the command the Run and Build buttons start in a terminal. Leave empty to find it automatically: the extension tries `PATH` first, then asks a login shell, because the extension host's `PATH` is the one VS Code was launched with and often omits `~/.local/bin`."
        },
        "rbx.statementDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report the errors of the last statement build in the Problems panel, on the line of the statement source (or template) they come from."
        },
        "rbx.statements.buildOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Rebuild a statement whenever you save its source, or a file beside it: `rbx statements build --no-validate`, or `rbx tutorials build --no-validate` for a tutorial, in their contest form for a contest's. The samples are not validated; `rbx build` does that. Runs as a task in a visible terminal, like the **Build** button of the statement preview, and is skipped while another rbx command runs in the same package."
        },
        "rbx.dispatch.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the buttons that start `rbx run` and `rbx build` from the editor: the **Run** CodeLens on a solution, the editor-title and view buttons, and the commands behind them. Each one runs its command as a task in a visible terminal; the extension never runs a build in the background or reads its output. Turn this off to go back to only watching what you run yourself."
        },
        "rbx.run.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to every `rbx run` the extension starts -- including each problem's run in *Run All Problems in the Contest* -- one per item, for example `[\"--sanitized\"]` or `[\"--detailed\"]`."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "rbx",
        "required": [
          "command",
          "cwd"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "contest-run",
              "statements",
              "contest-statements",
              "tutorials",
              "contest-tutorials",
              "stress",
              "add-finding",
              "irun",
              "promote"
            ],
            "description": "Describes the tasks the rbx extension starts from its buttons; rbx tasks cannot be declared in tasks.json. The rbx command: `build`, `run`, `contest-run` (`rbx contest each --inline run`), `statements`/`tutorials` (`rbx statements build`/`rbx tutorials build`), or their `contest-` forms, `stress`, `add-finding` (`rbx testcases add-finding`), `irun`, or `promote` (`rbx testcases promote`)."
          },
          "cwd": {
            "type": "string",
            "description": "The package root (or contest root, for a contest command) the command runs in."
          },
          "solutions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For `run`: the solutions to run, relative to `cwd`. Empty runs every solution."
          },
          "contest": {
            "type": "string",
            "description": "The contest variant id passed as `-C`, or an empty string for the canonical contest.rbx.yml."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For `stress`, `add-finding`, `irun` and `promote`: the arguments after the subcommand."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "pretest": "node esbuild.mjs && node esbuild.test.mjs",
    "test": "node --test \"out-test/**/*.test.js\"",
    "lint": "eslint src",
    "vscode:prepublish": "npm run package",
    "vsix": "mkdir -p ../rbx/resources/vscode && vsce package --no-dependencies --out ../rbx/resources/vscode/"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.23.0",
    "pdfjs-dist": "4.10.38",
    "typescript": "^5.5.0"
  }
}
