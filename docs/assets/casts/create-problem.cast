[2.881853, "o", "\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0;38;5;67m?\u001b[0;1m Which preset do you want to use? \u001b[0m(Use arrow keys)\u001b[0m\r\r\n\u001b[0m \u00bb \u001b[0;7mdefault \u2014 rbx's default preset: ICPC-style problem/contest with testlib, jngen and tgen.\u001b[91D\u001b[A\u001b[51C\u001b[?7h\u001b[0m"]
[5.951297, "o", "\u001b[?7l\u001b[51D\u001b[0m\u001b[J\u001b[0;38;5;67m?\u001b[0;1m Which preset do you want to use? \u001b[0;38;5;214;1mdefault \u2014 rbx's default preset: ICPC-style problem/contest with \r\u001b[99Ct\u001b[0m\r\r\n\u001b[0;38;5;214;1mestlib, jngen and tgen.\u001b[23D\u001b[0m\r\r\n\u001b[J\u001b[?7h\u001b[0m\u001b[?2004l\u001b[?12l\u001b[?25h"]
[6.39246, "o", "\u001b[90mCloning preset from \u001b[0m\u001b[1;34mhttps://github.com/rsalesc/rbx\u001b[0m\u001b[90m...\u001b[0m\r\n"]
