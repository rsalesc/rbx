[5.381443, "o", "8;18;18m \u001b[0m\u001b[90;48;2;18;18;18m  and every solution expected to be too slow must take at least 1.5x the limit, checked afterwa\u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\r\n\u001b[17;41H\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[90;48;2;18;18;18mrds (timeLimitToTle)\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m                                                                           \u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\r\n\u001b[18;41H\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[90;48;2;18;18;18m  rounded up to a multiple of 100 ms (timeResolution)\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m                                          \u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\r\n\u001b[19;41H\u001b[38;2;254;166;43;48;2;18;18;18m\u2502\u001b[0m\u001b[48;2;18;18;18m \u001b[0m\u001b[90;48;2;18;18;18m  the accepted solutions run capped at 10000 ms (inferenceTimeout)\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m        "]
