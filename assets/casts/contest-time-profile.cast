[18.878712, "o", "\u001b[33m\u29d6\u001b[0m\u001b[90m \u001b[0m\u001b[90mmain/0\u001b[0m\u001b[90m (>150 ms, 11 MiB)\u001b[0m\r\n\u001b[90m\u2298\u001b[0m\u001b[90m \u001b[0m\u001b[90mmain/1\u001b[0m\u001b[90m (-, -)\u001b[0m\u001b[90m: \u001b[0m\u001b[3;90mSkipped: an earlier testcase already decided this run.\u001b[0m\r\n\u001b[90m\u2298\u001b[0m\u001b[90m \u001b[0m\u001b[90mmain/2\u001b[0m\u001b[90m (-, -)\u001b[0m\u001b[90m: \u001b[0m\u001b[3;90mSkipped: an earlier testcase already decided this run.\u001b[0m\r\n\u001b[90m  \u001b[0m\u001b[97mmain\u001b[0m\u001b[90m \u001b[0m\u001b[90m(>150 ms, 11 MiB)\u001b[0m\r\n\r\n\u001b[1;32mOK\u001b[0m\u001b[90m \u001b[0m\r\n\u001b[90mTime: >150 ms\u001b[0m\r\n\u001b[90mMemory: 11 MiB\u001b[0m\r\n\u001b[97mRan in\u001b[0m\u001b[90m 0.5s.\u001b[0m\r\n\r\n\u001b[1;32m\u2713 \u001b[0m\u001b]8;;file://~/problems/summer-cup/problems/gardens/sols/quadratic.cpp\u001b\\\u001b[1;33msols/quadratic.cpp\u001b[0m\u001b]8;;\u001b\\\u001b[1;32m is too slow for the estimated time limit, as expected.\u001b[0m\r\n\u001b[1;32mWriting the following timing profile to \u001b[0m\u001b]8;;~/problems/summer-cup/problems/gardens/.limits/boca.yml\u001b\\\u001b[1;34m.limits/boca.yml\u001b[0m\u001b]8;;\u001b\\\u001b[1;32m.\u001b[0m\r\n"]
