[20.883299, "o", "\u001b[97m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m\u001b[97mTime estimation\u001b[0m\u001b[97m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[20.887803, "o", "\u001b[90mUsing ratios:\u001b[0m\r\n\u001b[90m  the limit is at least 2.0x the slowest accepted solution (acToTimeLimit)\u001b[0m\r\n\u001b[90m  and every solution expected to be too slow must take at least 1.5x the limit, checked afterwards \u001b[0m\r\n\u001b[90m(timeLimitToTle)\u001b[0m\r\n\u001b[90m  rounded up to a multiple of 100 ms (timeResolution)\u001b[0m\r\n\u001b[90m  the accepted solutions run capped at 10000 ms (inferenceTimeout)\u001b[0m\r\n\u001b[1;32mWriting the following timing profile to \u001b[0m\u001b]8;;~/problems/timing-problem/.limits/local.yml\u001b\\\u001b[1;34m.limits/local.yml\u001b[0m\u001b]8;;\u001b\\\u001b[1;32m.\u001b[0m\r\n"]
[20.896737, "o", "\u001b[1;97m                                        Time limits (local)                                         \u001b[0m\r\n\u001b[90m\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\u001b[0m\r\n\u001b[90m\u2503\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97mLanguages\u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2503\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97mSolutions\u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2503\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97mTime Limit\u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2503\u001b[0m\u001b[1;97m \u001b[0m\u001b[1;97mSource                                                     \u001b[0m\u001b[1;97m \u001b[0m\u001b[90m\u2503\u001b[0m\r\n\u001b[90m\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\u001b[0m\r\n"]
