{
  "name": "rbx-vscode",
  "displayName": "rbx",
  "description": "Browse rbx testcases and solution verdicts without leaving the editor.",
  "version": "2.3.3",
  "publisher": "rsalesc",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsalesc/rbx.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/problem.rbx.yml",
    "onView:rbx.run",
    "onView:rbx.testset",
    "onView:rbx.stress"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rbx",
          "title": "rbx",
          "icon": "resources/rbx.svg"
        }
      ]
    },
    "views": {
      "rbx": [
        {
          "id": "rbx.assets",
          "name": "Assets",
          "contextualTitle": "rbx"
        },
        {
          "id": "rbx.run",
          "type": "webview",
          "name": "Run",
          "contextualTitle": "rbx"
        },
        {
          "id": "rbx.testset",
          "type": "webview",
          "name": "Tests",
          "contextualTitle": "rbx"
        },
        {
          "id": "rbx.stress",
          "type": "webview",
          "name": "Stress",
          "contextualTitle": "rbx"
        }
      ]
    },
    "commands": [
      {
        "command": "rbx.testplan.generate",
        "title": "Generate This Test",
        "category": "rbx"
      },
      {
        "command": "rbx.testplan.validate",
        "title": "Validate This Test",
        "category": "rbx"
      },
      {
        "command": "rbx.testplan.run",
        "title": "Run Solutions on This Test",
        "category": "rbx"
      },
      {
        "command": "rbx.testplan.promote",
        "title": "Promote This Test…",
        "category": "rbx"
      },
      {
        "command": "rbx.refresh",
        "title": "Refresh",
        "category": "rbx",
        "icon": "$(refresh)"
      },
      {
        "command": "rbx.openSolution",
        "title": "Open Solution",
        "category": "rbx",
        "icon": "$(go-to-file)"
      },
      {
        "command": "rbx.openInput",
        "title": "Open Input",
        "category": "rbx",
        "icon": "$(file)"
      },
      {
        "command": "rbx.openOutput",
        "title": "Open Output",
        "category": "rbx"
      },
      {
        "command": "rbx.openAnswer",
        "title": "Open Expected Answer",
        "category": "rbx"
      },
      {
        "command": "rbx.openStderr",
        "title": "Open Stderr",
        "category": "rbx"
      },
      {
        "command": "rbx.diffOutput",
        "title": "Diff Output against Expected Answer",
        "category": "rbx",
        "icon": "$(git-compare)"
      },
      {
        "command": "rbx.revealInExplorer",
        "title": "Reveal Problem in Explorer",
        "category": "rbx"
      },
      {
        "command": "rbx.selectProblem",
        "title": "Select Problem",
        "category": "rbx",
        "icon": "$(list-selection)"
      },
      {
        "command": "rbx.copyPath",
        "title": "Copy Path",
        "category": "rbx"
      },
      {
        "command": "rbx.openCompileLog",
        "title": "Open Compiler Output",
        "category": "rbx",
        "icon": "$(output)"
      },
      {
        "command": "rbx.openTestcase",
        "title": "Open Testcase",
        "category": "rbx"
      },
      {
        "command": "rbx.showOutput",
        "title": "Show Output vs Answer",
        "category": "rbx"
      },
      {
        "command": "rbx.showStderr",
        "title": "Show Stderr",
        "category": "rbx"
      },
      {
        "command": "rbx.showLog",
        "title": "Show Run Log",
        "category": "rbx"
      },
      {
        "command": "rbx.showInteraction",
        "title": "Show Interaction",
        "category": "rbx"
      },
      {
        "command": "rbx.showInteractorStderr",
        "title": "Show Interactor Stderr",
        "category": "rbx"
      },
      {
        "command": "rbx.showInteractorLog",
        "title": "Show Interactor Log",
        "category": "rbx"
      },
      {
        "command": "rbx.showCheckerStderr",
        "title": "Show Checker Stderr",
        "category": "rbx"
      },
      {
        "command": "rbx.copyInteraction",
        "title": "Copy Interaction as .interaction",
        "category": "rbx",
        "icon": "$(copy)"
      },
      {
        "command": "rbx.openGeneratorScript",
        "title": "Open Generator Script",
        "category": "rbx"
      },
      {
        "command": "rbx.openCopiedFrom",
        "title": "Open Copied-From Testcase",
        "category": "rbx"
      },
      {
        "command": "rbx.openBuiltTestcase",
        "title": "Open Testcase",
        "category": "rbx"
      },
      {
        "command": "rbx.openTestVisualization",
        "title": "Open Input Visualization",
        "category": "rbx",
        "icon": "$(graph)"
      },
      {
        "command": "rbx.openTestAnswerVisualization",
        "title": "Open Answer Visualization",
        "category": "rbx"
      },
      {
        "command": "rbx.openVisualizationExternally",
        "title": "Open Visualization in External Browser",
        "category": "rbx",
        "icon": "$(link-external)"
      },
      {
        "command": "rbx.copyTestPath",
        "title": "Copy Test Input Path",
        "category": "rbx"
      },
      {
        "command": "rbx.revealTestInExplorer",
        "title": "Reveal Test in Explorer",
        "category": "rbx"
      },
      {
        "command": "rbx.openTestsetPanel",
        "title": "Open Testset Panel",
        "category": "rbx",
        "icon": "$(window)"
      },
      {
        "command": "rbx.openTestsetCoverage",
        "title": "Show Constraint Coverage",
        "category": "rbx"
      },
      {
        "command": "rbx.openTestsetStats",
        "title": "Show Testset Stats",
        "category": "rbx"
      },
      {
        "command": "rbx.visualizeTest",
        "title": "Visualize Testcase Input",
        "category": "rbx"
      },
      {
        "command": "rbx.visualizeTestAnswer",
        "title": "Visualize Expected Answer",
        "category": "rbx"
      },
      {
        "command": "rbx.visualizeSolutionOutput",
        "title": "Visualize Solution's Output",
        "category": "rbx"
      },
      {
        "command": "rbx.openStatementPreview",
        "title": "Open Statement Preview",
        "category": "rbx",
        "icon": "$(open-preview)"
      },
      {
        "command": "rbx.buildStatements",
        "title": "Build Statements",
        "category": "rbx",
        "icon": "$(file-pdf)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.runSolution",
        "title": "Run This Solution",
        "category": "rbx",
        "icon": "$(play)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.irunTest",
        "title": "Run Solutions on This Test…",
        "category": "rbx",
        "icon": "$(debug-alt)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.irunInput",
        "title": "Run Solutions on This Input",
        "category": "rbx",
        "icon": "$(debug-alt)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.irunGenerator",
        "title": "Run Solutions on a Generator Call…",
        "category": "rbx",
        "icon": "$(debug-alt)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.runAll",
        "title": "Run All Solutions",
        "category": "rbx",
        "icon": "$(run-all)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.build",
        "title": "Build Tests",
        "category": "rbx",
        "icon": "$(tools)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.rerun",
        "title": "Re-run Last Command",
        "category": "rbx",
        "icon": "$(debug-rerun)",
        "enablement": "rbx.dispatchEnabled && rbx.canRerun"
      },
      {
        "command": "rbx.runContest",
        "title": "Run All Problems in the Contest",
        "category": "rbx",
        "icon": "$(run-all-coverage)",
        "enablement": "rbx.dispatchEnabled && rbx.activeInContest"
      },
      {
        "command": "rbx.changeContest",
        "title": "Change Contest for Dispatched Commands",
        "category": "rbx",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.stress.new",
        "title": "New Stress…",
        "category": "rbx",
        "icon": "$(add)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.stress.stop",
        "title": "Stop Stress",
        "category": "rbx",
        "icon": "$(debug-stop)",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.stress.openLauncher",
        "title": "Open Stress Launcher",
        "category": "rbx",
        "enablement": "rbx.dispatchEnabled"
      },
      {
        "command": "rbx.stress.promote",
        "title": "Promote Stress Finding",
        "category": "rbx"
      },
      {
        "command": "rbx.promoteTest",
        "title": "Promote This Test…",
        "category": "rbx",
        "icon": "$(arrow-up)"
      },
      {
        "command": "rbx.promoteInput",
        "title": "Promote This Input to a Test…",
        "category": "rbx",
        "icon": "$(arrow-up)"
      },
      {
        "command": "rbx.proposal.accept",
        "title": "Accept Proposed Change",
        "category": "rbx",
        "icon": "$(check)"
      },
      {
        "command": "rbx.proposal.discard",
        "title": "Discard Proposed Change",
        "category": "rbx",
        "icon": "$(discard)"
      },
      {
        "command": "rbx.assets.refresh",
        "title": "Refresh Assets",
        "category": "rbx",
        "icon": "$(refresh)"
      },
      {
        "command": "rbx.assets.flat",
        "title": "Show Assets Flat",
        "category": "rbx",
        "icon": "$(list-flat)"
      },
      {
        "command": "rbx.assets.split",
        "title": "Group Assets by Category",
        "category": "rbx",
        "icon": "$(symbol-folder)"
      },
      {
        "command": "rbx.assets.chooseContest",
        "title": "Choose Contest Variant",
        "category": "rbx",
        "icon": "$(versions)"
      },
      {
        "command": "rbx.assets.run",
        "title": "Run Solution",
        "category": "rbx",
        "icon": "$(play)"
      },
      {
        "command": "rbx.assets.openToSide",
        "title": "Open to the Side",
        "category": "rbx"
      },
      {
        "command": "rbx.assets.reveal",
        "title": "Reveal in Explorer View",
        "category": "rbx"
      },
      {
        "command": "rbx.assets.copyPath",
        "title": "Copy Path",
        "category": "rbx"
      },
      {
        "command": "rbx.across.chooseSlots",
        "title": "Choose Assets to Line Up",
        "category": "rbx",
        "icon": "$(filter)"
      },
      {
        "command": "rbx.assets.showAcross",
        "title": "Line Up Assets Across Problems",
        "category": "rbx",
        "icon": "$(layers)"
      },
      {
        "command": "rbx.assets.showByProblem",
        "title": "Show Assets by Problem",
        "category": "rbx",
        "icon": "$(list-tree)"
      },
      {
        "command": "rbx.run.collapseAll",
        "title": "Collapse All",
        "category": "rbx",
        "icon": "$(collapse-all)"
      },
      {
        "command": "rbx.testset.collapseAll",
        "title": "Collapse All",
        "category": "rbx",
        "icon": "$(collapse-all)"
      },
      {
        "command": "rbx.run.expandAll",
        "title": "Expand All",
        "category": "rbx",
        "icon": "$(expand-all)"
      },
      {
        "command": "rbx.testset.expandAll",
        "title": "Expand All",
        "category": "rbx",
        "icon": "$(expand-all)"
      },
      {
        "command": "rbx.run.showTiles",
        "title": "Show Testcases as Tiles",
        "category": "rbx",
        "icon": "$(table)"
      },
      {
        "command": "rbx.run.showRows",
        "title": "Show Testcases as Rows",
        "category": "rbx",
        "icon": "$(list-tree)"
      },
      {
        "command": "rbx.assets.openSource",
        "title": "Open Statement Source",
        "category": "rbx",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rbx.openStatementPreview",
          "when": "resourceScheme == file && resourcePath in rbx.statementFiles",
          "group": "navigation@2"
        },
        {
          "command": "rbx.buildStatements",
          "when": "rbx.dispatchEnabled && activeWebviewPanelId == 'rbx.statementPreview'",
          "group": "navigation@1"
        },
        {
          "command": "rbx.openVisualizationExternally",
          "when": "activeWebviewPanelId == 'rbx.visualization'",
          "group": "navigation@1"
        },
        {
          "command": "rbx.copyInteraction",
          "when": "resourceScheme == rbx && resourceFilename == interaction.io",
          "group": "navigation@1"
        },
        {
          "command": "rbx.runSolution",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.solutionFiles",
          "group": "navigation@0"
        },
        {
          "command": "rbx.proposal.accept",
          "when": "resourceScheme == rbx-proposed",
          "group": "navigation@0"
        },
        {
          "command": "rbx.proposal.discard",
          "when": "resourceScheme == rbx-proposed",
          "group": "navigation@1"
        },
        {
          "command": "rbx.irunInput",
          "when": "rbx.dispatchEnabled && resourceScheme == untitled",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "rbx.run.collapseAll",
          "when": "false"
        },
        {
          "command": "rbx.testset.collapseAll",
          "when": "false"
        },
        {
          "command": "rbx.run.expandAll",
          "when": "false"
        },
        {
          "command": "rbx.testset.expandAll",
          "when": "false"
        },
        {
          "command": "rbx.run.showTiles",
          "when": "!rbx.run.tiles"
        },
        {
          "command": "rbx.run.showRows",
          "when": "rbx.run.tiles"
        },
        {
          "command": "rbx.testplan.generate",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles"
        },
        {
          "command": "rbx.testplan.validate",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles"
        },
        {
          "command": "rbx.testplan.run",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.testplanFiles"
        },
        {
          "command": "rbx.testplan.promote",
          "when": "resourceScheme == file && resourcePath in rbx.testplanFiles"
        },
        {
          "command": "rbx.proposal.accept",
          "when": "resourceScheme == rbx-proposed"
        },
        {
          "command": "rbx.proposal.discard",
          "when": "resourceScheme == rbx-proposed"
        },
        {
          "command": "rbx.openVisualizationExternally",
          "when": "activeWebviewPanelId == 'rbx.visualization'"
        },
        {
          "command": "rbx.runSolution",
          "when": "rbx.dispatchEnabled && resourceScheme == file && resourcePath in rbx.solutionFiles"
        },
        {
          "command": "rbx.runAll",
          "when": "rbx.dispatchEnabled"
        },
        {
          "command": "rbx.build",
          "when": "rbx.dispatchEnabled"
        },
        {
          "command": "rbx.rerun",
          "when": "rbx.dispatchEnabled && rbx.canRerun"
        },
        {
          "command": "rbx.runContest",
          "when": "rbx.dispatchEnabled && rbx.activeInContest"
        },
        {
          "command": "rbx.changeContest",
          "when": "rbx.dispatchEnabled && rbx.activeInContest"
        },
        {
          "command": "rbx.stress.new",
          "when": "rbx.dispatchEnabled"
        },
        {
          "command": "rbx.stress.stop",
          "when": "rbx.dispatchEnabled && rbx.stressRunning"
        },
        {
          "command": "rbx.stress.openLauncher",
          "when": "false"
        },
        {
          "command": "rbx.stress.promote",
          "when": "false"
        },
        {
          "command": "rbx.irunTest",
          "when": "false"
        },
        {
          "command": "rbx.irunInput",
          "when": "rbx.dispatchEnabled && editorIsOpen"
        },
        {
          "command": "rbx.promoteTest",
          "when": "false"
        },
        {
          "command": "rbx.promoteInput",
          "when": "editorIsOpen"
        },
        {
          "command": "rbx.irunGenerator",
          "when": "rbx.dispatchEnabled"
        },
        {
          "command": "rbx.assets.run",
          "when": "false"
        },
        {
          "command": "rbx.assets.openToSide",
          "when": "false"
        },
        {
          "command": "rbx.assets.reveal",
          "when": "false"
        },
        {
          "command": "rbx.assets.copyPath",
          "when": "false"
        },
        {
          "command": "rbx.assets.openSource",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "rbx.runAll",
          "when": "view == rbx.run && rbx.dispatchEnabled",
          "group": "navigation@0"
        },
        {
          "command": "rbx.rerun",
          "when": "view == rbx.run && rbx.dispatchEnabled && rbx.canRerun",
          "group": "navigation@0"
        },
        {
          "command": "rbx.build",
          "when": "(view == rbx.run || view == rbx.testset) && rbx.dispatchEnabled",
          "group": "navigation@0"
        },
        {
          "command": "rbx.selectProblem",
          "when": "view == rbx.run || view == rbx.testset || view == rbx.stress",
          "group": "navigation@1"
        },
        {
          "command": "rbx.refresh",
          "when": "view == rbx.run || view == rbx.testset || view == rbx.stress",
          "group": "navigation@2"
        },
        {
          "command": "rbx.run.showTiles",
          "when": "view == rbx.run && !rbx.run.tiles",
          "group": "navigation@3"
        },
        {
          "command": "rbx.run.showRows",
          "when": "view == rbx.run && rbx.run.tiles",
          "group": "navigation@3"
        },
        {
          "command": "rbx.run.collapseAll",
          "when": "view == rbx.run && rbx.run.expanded",
          "group": "navigation@4"
        },
        {
          "command": "rbx.run.expandAll",
          "when": "view == rbx.run && !rbx.run.expanded",
          "group": "navigation@4"
        },
        {
          "command": "rbx.testset.collapseAll",
          "when": "view == rbx.testset && rbx.testset.expanded",
          "group": "navigation@4"
        },
        {
          "command": "rbx.testset.expandAll",
          "when": "view == rbx.testset && !rbx.testset.expanded",
          "group": "navigation@4"
        },
        {
          "command": "rbx.runContest",
          "when": "(view == rbx.run || view == rbx.testset) && rbx.dispatchEnabled && rbx.activeInContest",
          "group": "dispatch@1"
        },
        {
          "command": "rbx.changeContest",
          "when": "(view == rbx.run || view == rbx.testset) && rbx.dispatchEnabled && rbx.activeInContest",
          "group": "dispatch@2"
        },
        {
          "command": "rbx.stress.stop",
          "when": "view == rbx.stress && rbx.dispatchEnabled && rbx.stressRunning",
          "group": "navigation@0"
        },
        {
          "command": "rbx.stress.new",
          "when": "view == rbx.stress && rbx.dispatchEnabled",
          "group": "navigation@0"
        },
        {
          "command": "rbx.assets.showByProblem",
          "when": "view == rbx.assets && rbx.assets.across",
          "group": "navigation@0"
        },
        {
          "command": "rbx.assets.showAcross",
          "when": "view == rbx.assets && !rbx.assets.across",
          "group": "navigation@0"
        },
        {
          "command": "rbx.across.chooseSlots",
          "when": "view == rbx.assets && rbx.assets.across",
          "group": "navigation@1"
        },
        {
          "command": "rbx.assets.flat",
          "when": "view == rbx.assets && !rbx.assets.across && !rbx.assets.flat",
          "group": "navigation@1"
        },
        {
          "command": "rbx.assets.split",
          "when": "view == rbx.assets && !rbx.assets.across && rbx.assets.flat",
          "group": "navigation@1"
        },
        {
          "command": "rbx.assets.chooseContest",
          "when": "view == rbx.assets && rbx.assets.hasVariants",
          "group": "navigation@2"
        },
        {
          "command": "rbx.assets.refresh",
          "when": "view == rbx.assets",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "rbx.runSolution",
          "when": "webviewSection == 'rbx.solution' && rbx.dispatchEnabled",
          "group": "0_run@1"
        },
        {
          "command": "rbx.openSolution",
          "when": "webviewSection == 'rbx.solution'",
          "group": "1_open@1"
        },
        {
          "command": "rbx.openInput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@1"
        },
        {
          "command": "rbx.openOutput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@2"
        },
        {
          "command": "rbx.openAnswer",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@3"
        },
        {
          "command": "rbx.openStderr",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@4"
        },
        {
          "command": "rbx.diffOutput",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "2_compare@1"
        },
        {
          "command": "rbx.copyPath",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "3_copy@1"
        },
        {
          "command": "rbx.openSolution",
          "when": "webviewSection == 'rbx.finding'",
          "group": "1_open@1"
        },
        {
          "command": "rbx.openCompileLog",
          "when": "webviewSection == 'rbx.finding'",
          "group": "1_open@2"
        },
        {
          "command": "rbx.openTestcase",
          "when": "webviewSection == 'rbx.testcase'",
          "group": "1_open@0"
        },
        {
          "command": "rbx.showOutput",
