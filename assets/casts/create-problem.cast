[2.875591, "o", "\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0;38;5;67m?\u001b[0;1m Which preset do you want to use? \u001b[0m(Use arrow keys)\u001b[0m\r\r\n\u001b[0m \u00bb \u001b[0;7mdefault \u2014 rbx's default preset: ICPC-style problem/contest with testlib, jngen and tgen.\u001b[91D\u001b[A\u001b[51C\u001b[?7h\u001b[0m"]
